views:
  - type: bases-spotlight-view
    name: PDF Viewer
    filters:
      and:
        - file.inFolder("Sources/How to Read a Book - Mortimer & Van Adler")
    order:
      - file.name
      - file.tags
      - pages
      - type
      - subtype
      - open
      - publish
      - title
  - type: cards
    name: Table View
    filters:
      and:
        - file.inFolder("Sources/How to Read a Book - Mortimer & Van Adler")
    indentProperties: true
    cardSize: 490
